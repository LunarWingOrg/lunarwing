{
  "$schema": "https://github.com/nanogpt-community/nanocode/config.json",
  "model": "nanogpt/tensorzero::function_name::lunarwing",
  "theme": "moonlight",
  "plugin": [
    "opencode-agent-memory",
    "opencode-agent-skills"
  ],
  "provider": {
    "nanogpt": {
      "name": "TensorZero",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:TENSORZERO_API_KEY}",
        "baseURL": "http://192.168.1.157:3000/openai/v1/"
      },
      "models": {
        "tensorzero::function_name::lunarwing": {
          "name": "tensorzero::function_name::lunarwing"
        }
      }
    }
  }
}


