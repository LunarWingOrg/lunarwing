# ──────────────────────────────────────────────────────────────────────────────
# LunarWing Nanocode Worker — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values.

# ── LLM / TensorZero ──────────────────────────────────────────────────────────
# API key for TensorZero gateway (can be "dummy" if TZ doesn't enforce auth)
TENSORZERO_API_KEY=dummy

# Direct NanoGPT API key (if not using TensorZero routing)
# NANOGPT_API_KEY=

# OpenAI-compatible key (fallback, if your provider requires one)
# OPENAI_API_KEY=

# ── LunarWing WebSocket Authentication ────────────────────────────────────────
# Bearer token that LunarWing agents must present to connect.
# Leave empty to disable auth (dev mode only).
AGENT_AUTH_TOKEN=

# Unique identifier for this worker instance
LUNARWING_WORKER_ID=worker-nanocode-01

# ── WebSocket Server ──────────────────────────────────────────────────────────
# Role: "server" (agents connect to worker) or "client" (worker connects to hub)
WS_ROLE=server

# Server mode: bind address and port
WS_BIND_HOST=0.0.0.0
WS_PORT=9090
WS_PATH=/ws/agent

# Client mode: hub URL to connect to (only used when WS_ROLE=client)
# WS_URL=ws://agent-hub:9000/nanocode

# Reconnect delay in ms (client mode)
RECONNECT_MS=3000

# ── Nanocode Internal Server ──────────────────────────────────────────────────
# Port for the headless nanocode HTTP/SSE server (internal, not exposed)
NANOCODE_SERVE_PORT=4096
NANOCODE_SERVE_HOST=127.0.0.1

# Basic auth password for nanocode serve (optional, secures internal endpoint)
# NANOGPT_SERVER_PASSWORD=
# NANOGPT_SERVER_USERNAME=nanocode

# ── Health Check ──────────────────────────────────────────────────────────────
HEALTH_PORT=8443

# ── Container / Filesystem ────────────────────────────────────────────────────
# Host group ID for volume permissions
HOST_GID=1000

# File creation umask (0002 = group-writable)
FILE_UMASK=0002

# Workspace root inside container
WORKSPACE_ROOT=/workspace

# ── Git / GitHub Credentials ──────────────────────────────────────────────────
# GitHub personal access token (used by gh CLI and git HTTPS auth)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GH_TOKEN=  # Alternative to GITHUB_TOKEN (gh CLI checks both)

# Git identity (used for commits inside the container)
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# ── SSH / Git Credential Mounts ──────────────────────────────────────────────
# Path to host SSH directory (mounted read-only into container)
# SSH_DIR=~/.ssh

# Path to host .gitconfig file (mounted read-only into container)
# GITCONFIG_FILE=~/.gitconfig

# ── Custom Secrets ────────────────────────────────────────────────────────────
# Path to an extra env file with custom secrets (e.g. NPM_TOKEN, API keys)
# Create .env.secrets in this directory, or point to another file.
# EXTRA_ENV_FILE=.env.secrets

# ── Config Override ───────────────────────────────────────────────────────────
# Path to opencode.json on the host (mounted read-only into container)
# NANOCODE_CONFIG_FILE=./config/opencode.json
