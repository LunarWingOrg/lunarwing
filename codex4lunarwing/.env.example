# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Codex model ───────────────────────────────────────────────────────────────
# See: https://platform.openai.com/docs/models
CODEX_MODEL=codex-mini-latest

# ── LunarWing WebSocket auth ──────────────────────────────────────────────────
# Leave empty for dev mode (no auth required)
AGENT_AUTH_TOKEN=

# ── Worker identity ───────────────────────────────────────────────────────────
LUNARWING_WORKER_ID=worker-codex-01

# ── Ports ─────────────────────────────────────────────────────────────────────
HEALTH_PORT=8443
WS_PORT=9090
WS_PATH=/ws/agent

# ── WebSocket role ────────────────────────────────────────────────────────────
# server = listen for inbound agent connections (default)
# client = connect outbound to a hub
WS_ROLE=server
# WS_URL=ws://agent-hub:9000/codex  # Only needed for client role

# ── File permissions ──────────────────────────────────────────────────────────
FILE_UMASK=0002
HOST_GID=1000

# ── Git / GitHub ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GH_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# ── Host mounts (optional) ────────────────────────────────────────────────────
# SSH_DIR=~/.ssh
# GITCONFIG_FILE=~/.gitconfig
# EXTRA_ENV_FILE=.env.secrets
