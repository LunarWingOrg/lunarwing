[Unit]
Description=LunarWing Vision OCR Sidecar (Podman rootless)
Documentation=https://github.com/LunarWingOrg/lunarwing/tree/main/projects/ocr-sidecar
After=podman.service
Requires=podman.service

[Service]
Type=simple
WorkingDirectory=/opt/lunarwing/projects/ocr-sidecar
Environment=LUNARWING_AUTH_TOKEN=${LUNARWING_AUTH_TOKEN}
Environment=OCR_PORT=8088
EnvironmentFile=-/etc/lunarwing/ocr-sidecar.env
ExecStartPre=/usr/bin/podman compose down --remove-orphans || true
ExecStart=/usr/bin/podman compose up --build
ExecStop=/usr/bin/podman compose down
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

# Rootless Podman: this unit runs as the user, not root
# Install to: ~/.config/systemd/user/ocr-sidecar.service
# Enable with: systemctl --user enable --now ocr-sidecar.service

[Install]
WantedBy=default.target
