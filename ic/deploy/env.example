# WARNING: Replace all CHANGE_ME values before deploying.
# Do not use placeholder passwords in production.

# Pin the Docker image version for deterministic deployments.
# Update this value when deploying a new release.
LUNARWING_VERSION=v1.1.9

DATABASE_URL=postgres://lunarwing:CHANGE_ME@localhost:5432/lunarwing

# Agent
AGENT_NAME=lunarwing
CLI_ENABLED=false

# Secrets
# 64 hex characters. Required when you want env-backed encrypted secrets
# instead of relying on the OS keychain.
SECRETS_MASTER_KEY=CHANGE_ME

# Web Gateway
GATEWAY_ENABLED=true
# 0.0.0.0 binds to all interfaces (required for Docker --network=host).
# Use 127.0.0.1 if running outside Docker or for local-only access.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
GATEWAY_AUTH_TOKEN=CHANGE_ME

# Restart Feature (Docker containers only)
# IMPORTANT: Set this in the container entrypoint or docker-compose to enable restart.
# Preferred env vars use the LUNARWING_* prefix. Legacy IRONCLAW_* names still work.
# The Docker entrypoint loop monitors exit codes:
#   - Exit code 0 = clean restart: reset failure counter, wait LUNARWING_RESTART_DELAY, restart
#   - Exit code ≠ 0 = failure: increment counter, exit after LUNARWING_MAX_FAILURES
LUNARWING_IN_DOCKER=false
LUNARWING_RESTART_DELAY=5          # seconds to wait before restarting (range: 1-30)
LUNARWING_MAX_FAILURES=10          # max consecutive failures before container exits

# Disabled for initial deploy
SANDBOX_ENABLED=false
HEARTBEAT_ENABLED=false
EMBEDDING_ENABLED=false
