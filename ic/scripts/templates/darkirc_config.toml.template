## ================
## Contact settings
## ================
##
## Contacts require out-of-band key exchange. For each contact:
##   1. Generate a keypair:  darkirc --gen-chacha-keypair
##   2. Share YOUR public key with the contact (out of band)
##   3. Receive THEIR public key from the contact
##   4. Add the contact below with their public key and your secret key
##
## After editing contacts, reload:  kill -HUP $(cat <run_dir>/darkirc.pid)
##
## Format:
## [contact."nickname"]
## dm_chacha_public = "{contact's public key}"
## my_dm_chacha_secret = "{your secret key for this contact}"
##
## "nickname" is how they appear in your IRC client when they DM you.
## "dm_chacha_public" is the contact's public key (retrieve manually).
## "my_dm_chacha_secret" is YOUR secret key for decrypting their DMs.
##   It is recommended to paste their public key as a comment for reference.
## **You should never share secret keys with anyone**
##
## Examples (uncomment and fill in after key exchange):
#[contact."satoshi"]
#dm_chacha_public = "C9vC6HNDfGQofWCapZfQK5MkV1JR8Cct839RDUCqbDGK"
#my_dm_chacha_secret = "A3mLrq4aW9UkFVY4zCfR2aLdEEWVUdH4u8v4o2dgi4kC"
#
#[contact."anon"]
#dm_chacha_public = "7iTddcopP2pkvszFjbFUr7MwTcMSKZkYP6zUan22pxfX"
#my_dm_chacha_secret = "E229CzXev335cxhHiJyuzSapz7HMfNzf6ipbginFTvtr"
