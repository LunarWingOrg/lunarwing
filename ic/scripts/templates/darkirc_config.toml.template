## Per-tenant darkirc configuration for __TENANT_NAME__
## Auto-generated by lunarwing-mt-admin — edit with care.
## Reload with: kill -HUP $(cat <run_dir>/darkirc.pid)
##
## Placeholders substituted at generation time:
##   __TENANT_NAME__   — tenant OS username
##   __IRC_PORT__      — per-tenant IRC listen port
##   __RPC_PORT__      — per-tenant JSON-RPC listen port
##   __CONFIG_DIR__    — tenant darkirc state dir (datastore, hostlist, etc.)
##   __LOG_DIR__       — tenant log directory

## IRC listen URL — bound to loopback only (adapter connects locally)
irc_listen = "tcp://127.0.0.1:__IRC_PORT__"

## List of channels to autojoin for new client connections
autojoin = [
    "#dev",
    "#media",
    "#hackers",
    "#memes",
    "#philosophy",
    "#markets",
    "#math",
    "#random",
    "#lunardao",
]

## JSON-RPC settings
[rpc]
## JSON-RPC listen URL — loopback only (daemon control plane)
rpc_listen = "tcp://127.0.0.1:__RPC_PORT__"

## Disabled RPC methods
rpc_disabled_methods = ["p2p.get_info"]

## P2P network settings
[net]
## Path to the P2P datastore
p2p_datastore = "__CONFIG_DIR__/datastore"

## Path to a configured hostlist for saving known peers
hostlist = "__CONFIG_DIR__/datastore/p2p_hostlist.tsv"

## Outbound connection slots
outbound_connections = 7

## Addresses we want to advertise to peers (optional)
## These should be reachable externally — uncomment and set if you have
## a public address (Tor onion, public IP, etc.)
#external_addrs = ["tor://<your-onion>:25551"]

## Seed nodes to connect to
seeds = [
    "tcp+tls://lilith0.dark.fi:25551",
    "tcp+tls://lilith1.dark.fi:25551",
    "tor://fewhndztlb3otot5j2znszfaae5afuzhgkr7lfygfdash2vyrtpxa3id.onion:25551",
    "tor://darkficgji6ukoev46flygzjteoucz7a2mz6g3zvzeusym2ikomad3qd.onion:25551",
]

## Manual peers to connect to
#peers = []

## Whitelisted transports for outbound connections
allowed_transports = ["tcp+tls", "tor", "socks", "socks+tor"]

## Transports allowed to mix (e.g. Tor connecting to tcp:// endpoints)
mixed_transports = ["tor", "tcp+tls", "socks", "socks+tor"]

## Tor Socks5 proxy
tor_socks5_proxy = "socks5://127.0.0.1:9050"

