# Systemd service for WeeChat in a tmux session.
#
# Install notes:
#   1. Install this file as /etc/systemd/system/weechat.service.
#   2. Configure relay inside WeeChat:
#        /relay add api <RELAY_PORT>
#        /set relay.network.password "<RELAY_PASSWORD>"
#        /set relay.network.bind_address "127.0.0.1"
#   3. Attach to the session: tmux -L weechat attach -t weechat
#   4. Keep secrets in /etc/lunarwing/weechat.env with mode 0600.

[Unit]
Description=WeeChat IRC client (LunarWing)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=forking
User=lunarwing
Group=lunarwing

Environment=WEECHAT_HOME=/var/lib/lunarwing/.config/weechat
EnvironmentFile=-/etc/lunarwing/weechat.env

ExecStart=/usr/bin/tmux -L weechat new-session -d -s weechat '/usr/bin/weechat --dir ${WEECHAT_HOME}'
ExecStop=/usr/bin/tmux -L weechat kill-session -t weechat

Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0077

StateDirectory=lunarwing
StateDirectoryMode=0750

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lunarwing /tmp
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

StandardOutput=journal
StandardError=journal
SyslogIdentifier=weechat

[Install]
WantedBy=multi-user.target
