#!/sbin/openrc-run
# LunarWing per-tenant PostgreSQL containers (Podman) — boot service.
#
# Install as /etc/init.d/lunarwing-pg, then:  rc-update add lunarwing-pg default
#
# WHY THIS EXISTS: in a multi-tenant deployment each tenant's Postgres runs as a
# Podman container (lunarwing-pg-<tenant>). Unlike Docker, Podman has no daemon
# to honor `--restart unless-stopped` under OpenRC, so the containers would stay
# stopped after a reboot and the daemons could not connect. This service starts
# every lunarwing-pg-* container on boot and blocks until each accepts
# connections, so the per-tenant lunarwing daemons start against a ready DB.
#
# ORDERING: edit the `before` line in depend() to list your tenant daemons
# (lunarwing-<tenant>), or set `rc_before` in /etc/conf.d/lunarwing-pg. Without
# it the daemons will still come up via supervise-daemon respawn once the DB is
# ready, just less cleanly.

description="LunarWing per-tenant PostgreSQL containers (Podman)"

PODMAN=/usr/bin/podman

depend() {
    need net localmount
    after firewall
    before lunarwing-zeus lunarwing-mars lunarwing-ate
}

_pg_containers() {
    "$PODMAN" ps -a --format '{{.Names}}' 2>/dev/null | grep '^lunarwing-pg-' || true
}

start() {
    ebegin "Starting LunarWing Postgres containers"
    local c ret=0
    for c in $(_pg_containers); do
        "$PODMAN" start "$c" >/dev/null 2>&1 || ret=1
    done
    for c in $(_pg_containers); do
        local tries=0
        while ! "$PODMAN" exec "$c" pg_isready -U lunarwing -q 2>/dev/null; do
            tries=$((tries + 1))
            [ "$tries" -lt 60 ] || { eerror "$c not ready after 60s"; ret=1; break; }
            sleep 1
        done
    done
    eend "$ret"
}

stop() {
    ebegin "Stopping LunarWing Postgres containers"
    local c
    for c in $(_pg_containers); do
        "$PODMAN" stop "$c" >/dev/null 2>&1
    done
    eend 0
}
