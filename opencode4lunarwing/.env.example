# ──────────────────────────────────────────────────────────────────────────────
# LunarWing OpenCode Worker — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values.

# ── LLM / TensorZero ──────────────────────────────────────────────────────────
TENSORZERO_API_KEY=dummy

# OpenAI-compatible key (fallback, if your provider requires one)
# OPENAI_API_KEY=

# Per-tenant LLM overrides (set by lunarwing-mt-admin.sh in lunarwing.env).
# When either is set, entrypoint.sh materializes an overridden
# .opencode/opencode.json instead of using the image default.
# OPENCODE_MODEL=tensorzero::function_name::FrontierCODE
# OPENCODE_BASE_URL=http://192.168.1.157:3000/openai/v1/

# ── LunarWing WebSocket Authentication ────────────────────────────────────────
AGENT_AUTH_TOKEN=

# Unique identifier for this worker instance
LUNARWING_WORKER_ID=worker-opencode-01

# ── WebSocket Server ──────────────────────────────────────────────────────────
WS_ROLE=server
WS_BIND_HOST=0.0.0.0
WS_PORT=9090
WS_PATH=/ws/agent

# Client mode: hub URL to connect to (only used when WS_ROLE=client)
# WS_URL=ws://agent-hub:9000/opencode

RECONNECT_MS=3000

# ── OpenCode Internal Server ──────────────────────────────────────────────────
OPENCODE_SERVE_PORT=4096
OPENCODE_SERVE_HOST=127.0.0.1

# Basic auth for opencode serve (optional)
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=opencode

# ── Health Check ──────────────────────────────────────────────────────────────
HEALTH_PORT=8443

# ── Container / Filesystem ────────────────────────────────────────────────────
HOST_GID=1000
FILE_UMASK=0002
WORKSPACE_ROOT=/workspace

# ── Git / GitHub Credentials ──────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GH_TOKEN=
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# ── SSH / Git Credential Mounts ──────────────────────────────────────────────
# SSH_DIR=~/.ssh
# GITCONFIG_FILE=~/.gitconfig

# ── Custom Secrets ────────────────────────────────────────────────────────────
# EXTRA_ENV_FILE=.env.secrets

# ── Config Override ───────────────────────────────────────────────────────────
# OPENCODE_CONFIG_FILE=./config/opencode.json

# ── Optional Paseo MCP Integration ────────────────────────────────────────────
# When both are set, a paseo MCP entry is injected into the opencode config.
# PASEO_URL=http://127.0.0.1:6767
# PASEO_TOKEN=your-paseo-token
