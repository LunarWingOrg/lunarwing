{
  "$schema": "https://opencode.ai/config.json",
  "model": "tensorzero::function_name::lunarwing",
  "plugin": [
    "opencode-agent-identity",
    "opencode-agent-memory",
    "opencode-agent-skills",
    "oh-my-openagent"
  ],
  "provider": {
    "tensorzero": {
      "name": "TensorZero",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:TENSORZERO_API_KEY}",
        "baseURL": "http://192.168.1.157:3000/openai/v1/"
      },
      "models": {
        "tensorzero::function_name::lunarwing": {
          "name": "tensorzero::function_name::lunarwing"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  }
}
